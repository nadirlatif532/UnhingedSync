<Window x:Class="UnhingedSync.PeersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sharing &amp; Peers" Height="700" Width="780"
        MinHeight="320" MinWidth="480"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner">

  <!-- The whole page scrolls. This window has a lot of stacked panels and shrinking it
       used to clip the peer list and the footer off the bottom with no way to reach them.
       MinHeight on the inner grid is what gives the scrollbar something to scroll. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="16" MinHeight="560">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <!-- Auto, not star: the peer list grows with the team and the page scroller takes
           care of it. Star would clip it at whatever the window happened to be. -->
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── status ─────────────────────────────────────────────── -->
    <Border Grid.Row="0" x:Name="StatusPanel" CornerRadius="6" Padding="14,11"
            Background="#20242A" BorderBrush="{StaticResource Border}" BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="StatusHeadline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="Checking Syncthing…" />
        <TextBlock x:Name="StatusDetail" Foreground="{StaticResource TextDim}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />
        <Button x:Name="RunSetupButton" Content="Run Syncthing setup…" Margin="0,10,0,0"
                HorizontalAlignment="Left" Visibility="Collapsed" Click="RunSetup_Click" />
      </StackPanel>
    </Border>

    <!-- ── my device id ───────────────────────────────────────── -->
    <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="6" Padding="14,12"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="THIS MACHINE" Style="{StaticResource Label}" />
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="MyDeviceId" Grid.Column="0" IsReadOnly="True"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource Accent}"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   VerticalAlignment="Center" Text="…" />
          <Button Grid.Column="1" Content="Copy" Margin="8,0,0,0" Click="Copy_Click" />
        </Grid>
        <TextBlock Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Send this to someone already in the share so they can add you, or paste theirs below to invite them. Both sides have to agree; that is Syncthing's design, not a missing feature here." />

        <TextBlock Text="HOW YOU APPEAR TO OTHERS" Style="{StaticResource Label}" Margin="0,12,0,0" />
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="MyNameBox" Grid.Column="0" Padding="8,6"
                   Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Border}"
                   BorderThickness="1" Foreground="{StaticResource Text}" FontSize="12"
                   ToolTip="The name your teammates see for this machine. Syncthing defaults it to the computer name, which is rarely a person." />
          <Button x:Name="SaveNameButton" Grid.Column="1" Content="Rename" Margin="8,0,0,0"
                  Click="SaveName_Click" />
        </Grid>
        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Text="Use your own name here. It is what everyone else sees in their peer list, and a list of computer names tells nobody who is who." />

        <!-- An action, not a state toggle. This was a checkbox called "this machine acts as
             the team's hub", which was close to theatre: Syncthing has no such flag, so
             ticking it only wrote a note that nothing else ever read. The button underneath
             it was the only part that did anything, so that is all that is left. -->
        <Border Background="{StaticResource PanelAlt}" CornerRadius="5" Padding="10,8"
                Margin="0,12,0,0">
          <StackPanel>
            <Button x:Name="ShareAllButton" Content="Offer the folder to every peer"
                    HorizontalAlignment="Left" Click="ShareAll_Click"
                    ToolTip="Makes sure every peer you know is actually being sent builds. Devices introduced by a hub are added automatically but are NOT offered the folder, so without this they appear paired and receive nothing." />
            <TextBlock x:Name="ActAsHubNote" Foreground="{StaticResource TextDim}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock x:Name="HubSummary" Foreground="{StaticResource TextDim}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ── add a peer ─────────────────────────────────────────── -->
    <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="6" Padding="14,12"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="ADD SOMEONE BY DEVICE ID" Style="{StaticResource Label}" />
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="PeerIdBox" Grid.Column="0" Padding="8,6"
                   Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Border}"
                   BorderThickness="1" Foreground="{StaticResource Text}"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12" />
          <Button x:Name="AddPeerButton" Grid.Column="1" Content="Add &amp; share"
                  Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddPeer_Click" />
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Their name" Style="{StaticResource Label}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="PeerNameBox" Grid.Column="1" Padding="8,6"
                   Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Border}"
                   BorderThickness="1" Foreground="{StaticResource Text}" FontSize="12"
                   ToolTip="Who this is, so your peer list is readable. Leave blank and their own name is used if they have set one." />
        </Grid>
        <!-- Says "they", not "this machine". It used to read "This machine is the team's
             hub" while actually describing the peer being added, directly above a second
             checkbox that really was about this machine. Two boxes opening with the same
             three words and meaning opposite things is what confused people onboarding. -->
        <CheckBox x:Name="IntroducerCheck" Margin="0,10,0,0"
                  Foreground="{StaticResource Text}" FontSize="12"
                  Content="They are our hub, so introduce me to the rest of the team"
                  ToolTip="Tick this when the ID you pasted belongs to the one machine everyone pairs with. Syncthing then learns about the rest of the team through them, so 30 people means 30 pairings instead of 435." />
        <TextBlock x:Name="IntroducerNote" Foreground="{StaticResource TextDim}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- ── pending + peers ────────────────────────────────────── -->
    <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="6"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
      <!-- Scrolling is the page's job, not this panel's: two nested scrollers means the
           mouse wheel gets swallowed by whichever one happens to be under the pointer. -->
      <ScrollViewer VerticalScrollBarVisibility="Disabled" Padding="14,12">
        <StackPanel>
          <TextBlock Text="WAITING FOR YOU" Style="{StaticResource Label}" />
          <ItemsControl x:Name="PendingList" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource PanelAlt}" CornerRadius="5"
                        Padding="10,8" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}"
                                 Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Accept" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Tag="{Binding}" Click="Accept_Click" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NoPending" Text="Nothing waiting." Style="{StaticResource Label}"
                     Margin="0,2,0,0" />

          <TextBlock Text="PEERS" Style="{StaticResource Label}" Margin="0,18,0,0" />
          <ItemsControl x:Name="PeersList" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource PanelAlt}" CornerRadius="5"
                        Padding="10,8" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DeviceId}" Style="{StaticResource Label}"
                                 FontFamily="Cascadia Mono, Consolas" Margin="0,3,0,0" />
                      <TextBlock Text="{Binding ShareText}" Style="{StaticResource Label}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding HubButtonText}"
                            IsEnabled="{Binding CanToggleHub}"
                            Tag="{Binding}" Click="ToggleHub_Click"
                            Margin="10,0,0,0" VerticalAlignment="Top"
                            ToolTip="A hub introduces its other peers to you automatically, so you only ever exchange IDs with one person." />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NoPeers" Text="No peers yet." Style="{StaticResource Label}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ── footer ─────────────────────────────────────────────── -->
    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{StaticResource PanelAlt}" CornerRadius="4" Padding="7,2"
                Margin="0,0,10,0">
          <TextBlock x:Name="RoleBadge" Style="{StaticResource Label}" Text="role: unknown" />
        </Border>
        <TextBlock x:Name="FolderStatus" Style="{StaticResource Label}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="Syncthing UI" Click="OpenWebUi_Click" />
        <Button Content="Refresh" Click="Refresh_Click" Margin="0" />
      </StackPanel>
    </Grid>
  </Grid>
  </ScrollViewer>
</Window>
