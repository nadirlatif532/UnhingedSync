<UserControl x:Class="UnhingedSync.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="180" />
    </Grid.RowDefinitions>

    <!-- ── header ─────────────────────────────────────────────── -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding ProjectName}" FontSize="20" FontWeight="SemiBold" />
        <Border Background="{StaticResource PanelAlt}" CornerRadius="4"
                Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Branch}" Foreground="{StaticResource Accent}" FontSize="12" />
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="ENGINE" Style="{StaticResource Label}" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding EngineOptions}"
                    SelectedItem="{Binding SelectedEngine, Mode=TwoWay}"
                    MinWidth="260" FontSize="12" Padding="6,3"
                    Background="{StaticResource PanelAlt}"
                    Foreground="{StaticResource Text}"
                    BorderBrush="{StaticResource Border}"
                    ToolTip="Which installed Unreal Engine to build with. The version a project targets comes from its .uproject, so this only chooses between installs on this machine." />
        </StackPanel>
        <TextBlock Text="{Binding EngineText}" Style="{StaticResource Label}"
                   HorizontalAlignment="Right" Margin="0,5,0,0" />
        <TextBlock Text="{Binding PublishRootText}" Style="{StaticResource Label}"
                   HorizontalAlignment="Right" Margin="0,3,0,0" />
        <TextBlock Text="{Binding AppVersionText}" Style="{StaticResource Label}"
                   HorizontalAlignment="Right" Margin="0,3,0,0"
                   ToolTip="Version of Unhinged Sync you are running. If a teammate reports different behaviour, compare this first." />
      </StackPanel>
    </Grid>

    <!-- ── status banner ──────────────────────────────────────── -->
    <Border Grid.Row="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,14"
            BorderThickness="1">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="#20242A" />
          <Setter Property="BorderBrush" Value="{StaticResource Border}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Ready">
              <Setter Property="Background" Value="#16301E" />
              <Setter Property="BorderBrush" Value="#2E6B41" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Skew">
              <Setter Property="Background" Value="#3A1C1F" />
              <Setter Property="BorderBrush" Value="#8C3A42" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
              <Setter Property="Background" Value="#3A1C1F" />
              <Setter Property="BorderBrush" Value="#8C3A42" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Warning">
              <Setter Property="Background" Value="#352C18" />
              <Setter Property="BorderBrush" Value="#7A6229" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="NeedsBinaries">
              <Setter Property="Background" Value="#1C2735" />
              <Setter Property="BorderBrush" Value="#35597F" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <StackPanel>
        <TextBlock Text="{Binding StatusHeadline}" FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource TextDim}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- ── actions ────────────────────────────────────────────── -->
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button Content="Sync &amp; Ensure Binaries"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding SyncAndEnsureCommand}"
                ToolTip="Pull the latest commit, then install matching binaries, building and publishing them here if nobody has yet." />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Content="Sharing…" Click="Sharing_Click"
                ToolTip="Syncthing pairing: your device ID, invite a teammate, and accept requests, without leaving this app." />
        <Button Content="Manage Binaries…" Click="ManageBinaries_Click"
                ToolTip="See every published build, delete individual ones, or keep only the newest few. This is the shared folder, so deletions affect the whole team." />
        <Button Content="Fetch Selected" Command="{Binding FetchSelectedCommand}"
                ToolTip="Install the binaries published for the selected commit." />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="Build Locally" Command="{Binding BuildLocallyCommand}"
                ToolTip="Compile this commit here instead of downloading it. Slower, but it leaves PDBs on your disk, which is the only way to get symbols you can debug with. PDBs are never published." />
        <Button Content="Build Log" Command="{Binding OpenLogCommand}"
                ToolTip="Open the published build log for the selected commit." />
        <Button Content="Copy Diagnostics" Command="{Binding CopyDiagnosticsCommand}"
                ToolTip="Copies version, engine, project and recent log details to the clipboard. Paste this when reporting a problem." />
        <Button Content="Open Editor" Command="{Binding OpenEditorCommand}" Margin="0" />
      </StackPanel>
    </Grid>

    <!-- ── commit list ────────────────────────────────────────── -->
    <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="6"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
      <DataGrid ItemsSource="{Binding Rows}"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="None"
                Background="Transparent" BorderThickness="0"
                RowBackground="Transparent" AlternatingRowBackground="#1A1A1E"
                Foreground="{StaticResource Text}"
                SelectionMode="Single" CanUserResizeRows="False"
                VerticalScrollBarVisibility="Auto"
                RowHeight="30" Margin="2">

        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
          </Style>
        </DataGrid.ColumnHeaderStyle>

        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsWorkspace}" Value="True">
                <Setter Property="Background" Value="#1E2A38" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>

        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="46">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Marker}" Foreground="{StaticResource Accent}"
                           FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="" Width="34">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding BadgeGlyph}" FontSize="14" VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{Binding BadgeColour, Converter={StaticResource HexToBrush}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="COMMIT" Binding="{Binding CommitLabel}" Width="80" />
          <DataGridTextColumn Header="BINARIES" Binding="{Binding BinariesText}" Width="140" />
          <DataGridTextColumn Header="AUTHOR" Binding="{Binding Author}" Width="130" />
          <DataGridTextColumn Header="WHEN" Binding="{Binding When}" Width="120" />
          <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- ── busy ───────────────────────────────────────────────── -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,6">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <ProgressBar IsIndeterminate="True" Width="180" Height="4"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding BusyText}" Margin="12,0,0,0"
                 Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- ── log ────────────────────────────────────────────────── -->
    <Border Grid.Row="5" Background="{StaticResource Panel}" CornerRadius="6"
            BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,6,0,0">
      <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}"
               IsReadOnly="True" Background="Transparent" BorderThickness="0"
               Foreground="#B9B9C2" FontFamily="Cascadia Mono, Consolas" FontSize="12"
               TextWrapping="NoWrap" Padding="10"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               TextChanged="LogBox_TextChanged" />
    </Border>
  </Grid>
</UserControl>
