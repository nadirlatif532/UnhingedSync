<Window x:Class="UnhingedSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unhinged Sync" Height="780" Width="1200"
        MinHeight="560" MinWidth="920"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ── shell bar ──────────────────────────────────────────── -->
    <Grid Grid.Row="0" Margin="16,14,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="Unhinged Sync" FontSize="14"
                 Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="Check for updates" Click="CheckUpdates_Click"
                ToolTip="Ask GitHub for a newer release now, instead of waiting for the next automatic check." />
        <Button Content="Add project…" Click="AddProject_Click"
                ToolTip="Open another Unreal project in its own tab." />
        <Button Content="Close project" Click="CloseProject_Click" Margin="0"
                ToolTip="Remove the current project from this list. Nothing on disk is touched." />
      </StackPanel>
    </Grid>

    <!-- ── one tab per project ────────────────────────────────── -->
    <TabControl x:Name="ProjectTabs" Grid.Row="1" Margin="10,12,10,10"
                Background="Transparent" BorderThickness="0" Padding="0" />

    <TextBlock x:Name="EmptyHint" Grid.Row="1" Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="{StaticResource TextDim}" FontSize="14" TextAlignment="Center"
               Text="No projects yet.&#x0a;Use “Add project…” and pick a folder containing a .uproject." />
  </Grid>
</Window>
