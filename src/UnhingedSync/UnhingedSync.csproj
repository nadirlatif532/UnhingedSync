<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UnhingedSync</AssemblyName>
    <RootNamespace>UnhingedSync</RootNamespace>
    <ApplicationTitle>Unhinged Sync</ApplicationTitle>

    <!-- Artists must not need a .NET install: publish one self-contained exe. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Shown in the UI, used to name the extracted script cache, and compared against
         the newest GitHub release by the updater. A release build overrides this from the
         git tag (see .github/workflows/release.yml), so this value is what local builds
         report; keep it in step with the last tag so a dev build is not mistaken for a
         released one. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- The scripts travel INSIDE the exe. That makes the zip a single file, and makes it
       impossible to run a script from one version against an exe from another - which is
       exactly the class of bug that wasted an afternoon. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\Invoke-UnhingedBuild.ps1" LogicalName="scripts/Invoke-UnhingedBuild.ps1" />
    <EmbeddedResource Include="..\..\scripts\Test-EngineIntegrity.ps1" LogicalName="scripts/Test-EngineIntegrity.ps1" />
    <EmbeddedResource Include="..\..\scripts\Reset-Ftue.ps1" LogicalName="scripts/Reset-Ftue.ps1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.7" />
  </ItemGroup>

</Project>
