<Window x:Class="UnhingedSync.ManageBinariesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Binaries" Height="580" Width="720"
        MinHeight="300" MinWidth="480"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="16" MinHeight="420">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── what deleting here actually does; filled in once the role is known ── -->
    <Border Grid.Row="0" x:Name="ScopeBanner" CornerRadius="6" Padding="14,11" Margin="0,0,0,12"
            Background="#20242A" BorderBrush="{StaticResource Border}" BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="ScopeHeadline" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="Checking what this machine is allowed to do…" />
        <TextBlock x:Name="ScopeDetail" Foreground="{StaticResource TextDim}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- ── actions ────────────────────────────────────────────── -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button Content="Select All" Click="SelectAll_Click" />
        <Button Content="Select None" Click="SelectNone_Click" />
        <Button Content="Refresh" Click="Refresh_Click"
                ToolTip="Re-read the folder. Teammates publish into it and retention prunes it, so a window left open goes stale." />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="KeepLastButton" Content="Clean Up" Click="KeepLast_Click" IsEnabled="False" />
        <Button x:Name="DeleteButton" Content="Delete Selected" Click="DeleteSelected_Click"
                IsEnabled="False" Margin="0" />
      </StackPanel>
    </Grid>

    <!-- ── list ───────────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="6"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
      <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="None"
                Background="Transparent" BorderThickness="0"
                RowBackground="Transparent" AlternatingRowBackground="#1A1A1E"
                Foreground="{StaticResource Text}"
                SelectionMode="Single" CanUserResizeRows="False"
                VerticalScrollBarVisibility="Auto"
                RowHeight="30" Margin="2">

        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
          </Style>
        </DataGrid.ColumnHeaderStyle>

        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
          </Style>
        </DataGrid.RowStyle>

        <DataGrid.Columns>
          <!-- A template column, not DataGridCheckBoxColumn: on a read-only grid the
               built-in one needs a click to focus the cell and a second to toggle. -->
          <DataGridTemplateColumn Header="" Width="36">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=Window}}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="COMMIT" Binding="{Binding CommitLabel}" Width="80" />
          <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90" />
          <DataGridTextColumn Header="STATE" Binding="{Binding StateText}" Width="90" />
          <DataGridTextColumn Header="BUILT" Binding="{Binding BuiltText}" Width="130" />
          <DataGridTextColumn Header="BUILT BY" Binding="{Binding BuiltBy}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- ── footer ─────────────────────────────────────────────── -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="SummaryText" Grid.Column="0" Style="{StaticResource Label}"
                 VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Close" Click="Close_Click" Margin="0" />
    </Grid>
  </Grid>
  </ScrollViewer>
</Window>
